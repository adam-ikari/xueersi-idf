# TinyGL PC Emulator Makefile
#
# Compiles the TinyGL rasterizer (vendored at components/tinygl/src/) and the
# shared render scene (main/tinygl_test.c) with an SDL2 display backend for
# PC development and benchmarking.
#
# Usage:
#   make              — build tinygl_emu
#   make clean        — remove build artifacts
#   make test         — build and launch (interactive, Ctrl+C to exit)
#   make benchmark    — build and run headless 1000-frame benchmark
#
# Prerequisites: SDL2 development libraries (sdl2-config must be in PATH).

CC      = gcc
TARGET  = tinygl_emu
BUILD_DIR = build

# ── Compile flags ───────────────────────────────────────────────
# -ffloat-store: force x86 to flush FP regs to memory, matching ESP32 precision
# -DTGL_EMU_BUILD: signal to tinygl_test.c that we're on PC
# -DTGL_PIXEL_BYTE_SWAP=1: match ESP32's big-endian RGB565 framebuffer layout
# -DTGL_TEXTURE_BYTE_SWAP=1: match ESP32 texture byte order
CFLAGS  = -O2 -std=c99
CFLAGS += -Wall -Wextra
CFLAGS += -Wno-unused-parameter    # vendored TinyGL has many stub params
CFLAGS += -Wno-unused-function     # vendored TinyGL inline stubs
CFLAGS += -Wno-unused-variable     # vendored TinyGL debug vars
CFLAGS += -Wno-implicit-fallthrough  # vendored TinyGL switch fallthroughs
CFLAGS += -D_GNU_SOURCE            # usleep() on Linux
CFLAGS += -DTGL_EMU_BUILD=1
CFLAGS += -DTGL_PIXEL_BYTE_SWAP=1
CFLAGS += -DTGL_TEXTURE_BYTE_SWAP=1
CFLAGS += -ffloat-store
CFLAGS += -I../../components/tinygl/include
CFLAGS += -I../../components/tinygl/src
CFLAGS += -I../../main
CFLAGS += -I../../components/hardware/include
CFLAGS += -Iemu_core
CFLAGS += -Iemu_tests
CFLAGS += -I$(BUILD_DIR)          # texture headers generated here
CFLAGS += $(shell sdl2-config --cflags)

LDFLAGS = $(shell sdl2-config --libs) -lm

# ── TinyGL source files (compiled directly from ESP32 project) ──
TINYGL_SRC = \
    ../../components/tinygl/src/zbuffer.c \
    ../../components/tinygl/src/ztriangle.c \
    ../../components/tinygl/src/zline.c \
    ../../components/tinygl/src/zraster.c \
    ../../components/tinygl/src/vertex.c \
    ../../components/tinygl/src/clip.c \
    ../../components/tinygl/src/init.c \
    ../../components/tinygl/src/api.c \
    ../../components/tinygl/src/texture.c \
    ../../components/tinygl/src/light.c \
    ../../components/tinygl/src/matrix.c \
    ../../components/tinygl/src/zmath.c \
    ../../components/tinygl/src/image_util.c \
    ../../components/tinygl/src/clear.c \
    ../../components/tinygl/src/list.c \
    ../../components/tinygl/src/arrays.c \
    ../../components/tinygl/src/specbuf.c \
    ../../components/tinygl/src/msghandling.c \
    ../../components/tinygl/src/memory.c \
    ../../components/tinygl/src/misc.c \
    ../../components/tinygl/src/accum.c \
    ../../components/tinygl/src/get.c \
    ../../components/tinygl/src/select.c \
    ../../components/tinygl/src/ztext.c \
    ../../components/tinygl/src/zpostprocess.c

# ── Shared scene sources (from ESP32 main/) ─────────────────────
SCENE_SRC = \
    ../../main/tinygl_test.c \
    ../../main/tinygl_physics.c \
    ../../main/display_st7735.c

# ── Emulator sources ─────────────────────────────────────────────
EMU_SRC = \
    main_emu.c \
    emu_core/emu_display.c \
    emu_core/emu_headless.c \
    emu_core/emu_bmp.c

# ── Test sources ─────────────────────────────────────────────────
TEST_SRC = \
    emu_tests/test_rasterizer.c \
    emu_tests/test_frame.c \
    emu_tests/test_runner.c

# ── Texture headers (generated by gen_texture.py) ────────────────
TEXTURES = ceramic checker brick grid
TEX_HEADERS = $(patsubst %, $(BUILD_DIR)/texture_%.h, $(TEXTURES))
GEN_TEX = ../../tools/gen_texture.py

# ── Objects ──────────────────────────────────────────────────────
# Use $(BUILD_DIR)/flat/ prefix to avoid subdirectory collisions.
# test_runner.c has its own main() — exclude it from the emulator binary.
ALL_SRC   = $(TINYGL_SRC) $(SCENE_SRC) $(EMU_SRC) $(TEST_SRC)
EMU_SRC_ONLY = $(TINYGL_SRC) $(SCENE_SRC) $(EMU_SRC) $(filter-out emu_tests/test_runner.c, $(TEST_SRC))
TEST_RUNNER_SRC = $(TINYGL_SRC) $(SCENE_SRC) $(EMU_SRC) $(TEST_SRC)

EMU_OBJ   = $(patsubst %.c, $(BUILD_DIR)/%.o, $(notdir $(EMU_SRC_ONLY)))
TEST_OBJ  = $(patsubst %.c, $(BUILD_DIR)/%.o, $(notdir $(TEST_RUNNER_SRC)))

# Resolve name conflicts: two directories may contain the same filename.
# vpath tells make where to look for %.c when building from a flat obj name.
vpath %.c $(sort $(dir $(ALL_SRC)))

.PHONY: all clean test benchmark test-rasterizer test-runner render-bmp

all: $(TEX_HEADERS) $(TARGET)

$(TARGET): $(EMU_OBJ)
	$(CC) $(EMU_OBJ) -o $@ $(LDFLAGS)

# Flat object build rule — relies on vpath to find source
$(BUILD_DIR)/%.o: %.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# ── Texture header generation ────────────────────────────────────
$(BUILD_DIR)/texture_%.h: $(GEN_TEX) | $(BUILD_DIR)
	python3 $(GEN_TEX) $* $@ texture_$* 256 256

clean:
	rm -rf $(BUILD_DIR) $(TARGET) test_runner

test: $(TARGET)
	./$(TARGET)

test-rasterizer: $(TARGET)
	@echo "=== Running rasterizer unit tests ==="
	@./$(TARGET) --test-rasterizer

# ── Test runner (separate binary, excludes main_emu.o) ──────────
TEST_RUNNER = test_runner
TEST_RUNNER_OBJ = $(filter-out $(BUILD_DIR)/main_emu.o, $(TEST_OBJ))

$(TEST_RUNNER): $(TEST_RUNNER_OBJ)
	$(CC) $^ -o $@ $(LDFLAGS)

test-runner: $(TEST_RUNNER)
	@echo "Running test_runner..."
	./$(TEST_RUNNER)

# Benchmark target (run interactive benchmark)
benchmark: $(TARGET)
	@echo "=== Running interactive benchmark ==="
	@echo "Press Ctrl+C to stop"
	./$(TARGET)

# Offline render-to-BMP target
render-bmp: $(TARGET)
	@mkdir -p bmp_out
	./$(TARGET) --render-bmp bmp_out 10 1
	@echo "BMP files saved to bmp_out/"
